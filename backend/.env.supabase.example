# 🥛 VIPUL MILK - SUPABASE POSTGRESQL CONNECTION CONFIGURATION
# Copy these values into your environment or replace in application.properties

# Replace [PROJECT-REF] and [YOUR-PASSWORD] with your actual Supabase project credentials.
# In your Supabase Dashboard: Project Settings -> Database -> Connection string -> URI or JDBC

# 1. Direct Connection (Port 5432):
DB_URL=jdbc:postgresql://db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=[YOUR-SUPABASE-DB-PASSWORD]

# OR 2. Connection Pooler / Transaction mode (Port 6543 or 5432 session pooler):
# DB_URL=jdbc:postgresql://aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# DB_USERNAME=postgres.[PROJECT-REF]
# DB_PASSWORD=[YOUR-SUPABASE-DB-PASSWORD]

# Owner Initial Credentials
OWNER_USERNAME=vipul
OWNER_PASSWORD=vipul@dairy2026

